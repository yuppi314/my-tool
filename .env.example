# サーバー設定
PORT=3000

# Stripe (未設定の場合、有料コンテンツの販売は停止し「近日公開」表示になります)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 開発用: true にすると Stripe なしで購入ボタンが即時に購入済み扱いになります(本番では設定しないこと)
MOCK_PAYMENTS=true

# 詳細レポートの価格 (円)
REPORT_PRICE_JPY=980

# 月額会員(毎日の運勢)の価格 (円/月)
SUBSCRIPTION_PRICE_JPY=480

# 管理画面(簡易統計)アクセス用トークン
ADMIN_TOKEN=changeme

# サイトURL (Stripe決済後のリダイレクト用)
BASE_URL=http://localhost:3000

# 家事の引き継ぎ表(LINE 公式アカウントの Messaging API)
# アクセストークンが未設定のときは LINE に送らず、ログに出すだけになります。
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# true にすると、食後の片付けが記録されたときにも親へ LINE を送ります(送信数が増えます)
KAJI_NOTIFY_DONE=false
