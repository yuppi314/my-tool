# サーバー設定
PORT=3000

# Stripe (未設定の場合は開発用モックモードで即時決済成功として動作します)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 詳細レポート(生年月日診断)の価格 (円)
REPORT_PRICE_JPY=980

# 本音診断 完全版レポートの価格 (円)
HONNE_PRICE_JPY=980

# 本音診断の価格ABテスト (カンマ区切り。未設定なら HONNE_PRICE_JPY の単価のみ)
# 例: HONNE_PRICE_AB=480,980 とすると診断ごとにランダムで価格を割り当て、
#     /admin.html の価格別テーブルで どの価格が一番売上が出るか比較できます。
HONNE_PRICE_AB=

# 管理画面(簡易統計)アクセス用トークン
ADMIN_TOKEN=changeme

# サイトURL (Stripe決済後のリダイレクト用)
BASE_URL=http://localhost:3000
