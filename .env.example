# サーバー設定
PORT=3000

# Stripe (未設定の場合、有料コンテンツの販売は停止し「近日公開」表示になります)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 開発用: true にすると Stripe なしで購入ボタンが即時に購入済み扱いになります(本番では設定しないこと)
MOCK_PAYMENTS=true

# 詳細レポートの価格 (円)
REPORT_PRICE_JPY=980

# 月額会員(毎日の運勢)の価格 (円/月)
SUBSCRIPTION_PRICE_JPY=480

# 管理画面(簡易統計)アクセス用トークン
ADMIN_TOKEN=changeme

# サイトURL (Stripe決済後のリダイレクト用)
BASE_URL=http://localhost:3000

# 事業者情報(特商法表記・利用規約・プライバシーポリシーに表示)。
# 1つでも空だと、Stripeを設定していても有料の新規申し込みは停止します(法令違反を防ぐため)。
# 自宅住所・電話番号を公開したくない個人事業主は、「請求があった場合には遅滞なく開示いたします」と入れる方法もあります。
OPERATOR_NAME=
OPERATOR_REPRESENTATIVE=
OPERATOR_ADDRESS=
OPERATOR_PHONE=
OPERATOR_EMAIL=
LEGAL_ENACTED_DATE=
# 管轄裁判所(空なら「当方の所在地を管轄する地方裁判所」)
OPERATOR_COURT=

# メールリストの保存先(Googleスプレッドシート)。設定方法は scripts/google-apps-script/README.md
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=
