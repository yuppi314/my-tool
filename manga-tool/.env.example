# Claude API — シナリオ生成に使用
ANTHROPIC_API_KEY=sk-ant-xxxxx

# サーバー設定
PORT=3001

# 画像生成プロバイダ: "placeholder"(デフォルト、APIキー不要) | "openai"
IMAGE_PROVIDER=placeholder

# IMAGE_PROVIDER=openai の場合に使用
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# PDF出力の判型(KDPペーパーバック向けデフォルト: 6x9インチ)
PDF_TRIM_WIDTH_IN=6
PDF_TRIM_HEIGHT_IN=9
